diff --git a/launcher/app/src/main/java/com/gathin/tvhome/AppLaunchActivity.java b/launcher/app/src/main/java/com/gathin/tvhome/AppLaunchActivity.java
new file mode 100644
index 00000000..1a9f6158
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/AppLaunchActivity.java
@@ -0,0 +1,28 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.content.ActivityNotFoundException;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+
+/** Handles market://launch?id=<package> (Android TV Remote "launch app" by package name), which the
+ *  stock launcher normally serves: opens the app's TV launch intent, then the phone launch intent. */
+public class AppLaunchActivity extends Activity {
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        try {
+            Uri data = getIntent().getData();
+            String pkg = data == null ? null : data.getQueryParameter("id");
+            if (pkg != null) {
+                Intent launch = getPackageManager().getLeanbackLaunchIntentForPackage(pkg);
+                if (launch == null) launch = getPackageManager().getLaunchIntentForPackage(pkg);
+                if (launch != null) startActivity(launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+            }
+        } catch (ActivityNotFoundException | SecurityException ignored) {
+        } finally {
+            finish();
+        }
+    }
+}
